<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>DATA_HORA_INGESTAO</name>
        <description>Data e hora da ingestao Bronze</description>
        <default_value>2026-09-28 13:30:00</default_value>
      </parameter>
      <parameter>
        <name>EXECUCAO_ID</name>
        <description>Identificador unico da execucao</description>
        <default_value>20260928_01</default_value>
      </parameter>
    </parameters>
    <name>bronze_catalogo_csv</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 18:16:10.916</created_date>
    <modified_date>2026/09/27 18:16:10.916</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Ler catalogo CSV</name>
    <filename>${PROJECT_HOME}/dados/brutos/catalogo.csv</filename>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>conteudo_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>titulo</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>tipo</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>categoria</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>nivel</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>carga_horaria_min</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>data_publicacao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>descricao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>autor</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>192</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>Adicionar auditoria</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>catalogo.csv</nullif>
        <name>origem</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>416</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Formula</type>
    <name>Adicionar parametros auditoria</name>
    <formulas>
      <formula>
        <field_name>execucao_id</field_name>
        <formula>"${EXECUCAO_ID}"</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>data_hora_ingestao</field_name>
        <formula>"${DATA_HORA_INGESTAO}"</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Converter data auditoria</name>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>data_hora_ingestao</name>
        <rename>data_hora_ingestao</rename>
        <type>Date</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>384</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Gravar Bronze catalogo</name>
    <connection>pg_plataforma_edu</connection>
    <schema>bronze</schema>
    <table>catalogo_raw</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>conteudo_id</stream_name>
        <column_name>conteudo_id</column_name>
      </field>
      <field>
        <stream_name>titulo</stream_name>
        <column_name>titulo</column_name>
      </field>
      <field>
        <stream_name>tipo</stream_name>
        <column_name>tipo</column_name>
      </field>
      <field>
        <stream_name>categoria</stream_name>
        <column_name>categoria</column_name>
      </field>
      <field>
        <stream_name>nivel</stream_name>
        <column_name>nivel</column_name>
      </field>
      <field>
        <stream_name>carga_horaria_min</stream_name>
        <column_name>carga_horaria_min</column_name>
      </field>
      <field>
        <stream_name>data_publicacao</stream_name>
        <column_name>data_publicacao</column_name>
      </field>
      <field>
        <stream_name>descricao</stream_name>
        <column_name>descricao</column_name>
      </field>
      <field>
        <stream_name>autor</stream_name>
        <column_name>autor</column_name>
      </field>
      <field>
        <stream_name>origem</stream_name>
        <column_name>origem</column_name>
      </field>
      <field>
        <stream_name>execucao_id</stream_name>
        <column_name>execucao_id</column_name>
      </field>
      <field>
        <stream_name>data_hora_ingestao</stream_name>
        <column_name>data_hora_ingestao</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>576</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler catalogo CSV</from>
      <to>Adicionar auditoria</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Adicionar auditoria</from>
      <to>Adicionar parametros auditoria</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Adicionar parametros auditoria</from>
      <to>Converter data auditoria</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Converter data auditoria</from>
      <to>Gravar Bronze catalogo</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>data_hora_ingestao</note>
      <markdown>Y</markdown>
      <notetype>GENERAL</notetype>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>336</xloc>
      <yloc>400</yloc>
      <width>32</width>
      <height>32</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
