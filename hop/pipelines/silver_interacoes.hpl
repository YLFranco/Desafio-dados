  <transform>
    <type>TableInput</type>
    <name>Ler Bronze interacoes</name>
    <sql>SELECT

    b.usuario_id,

    b.conteudo_id,

    b.tipo_interacao,

    b.data_hora,

    b.tempo_consumido,

    b.percentual_conclusao,

    b.avaliacao_atribuida,

    b.origem,

    b.execucao_id,

    b.data_hora_ingestao,



    CASE

        WHEN u.usuario_id IS NULL THEN 0

        ELSE 1

    END AS usuario_referencia_valida,



    CASE

        WHEN c.conteudo_id IS NULL THEN 0

        ELSE 1

    END AS conteudo_referencia_valida



FROM bronze.interacoes_raw b



LEFT JOIN public.usuario u

    ON u.usuario_id::text = b.usuario_id



LEFT JOIN public.conteudo c

    ON c.conteudo_id::text = b.conteudo_id



WHERE b.execucao_id = '${EXECUCAO_ID}'</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>pg_plataforma_edu</connection>
