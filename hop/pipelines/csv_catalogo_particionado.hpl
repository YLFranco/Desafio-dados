    <name>Ler Silver catalogo 2024</name>
    <sql>SELECT
    conteudo_id,
    titulo,
    tipo,
    categoria,
    nivel,
    carga_horaria_min,
    data_publicacao,
    descricao,
    autor,
    origem,
    execucao_id,
    data_hora_ingestao,
    EXTRACT(YEAR FROM data_publicacao)::int AS ano_publicacao
FROM silver.catalogo
WHERE EXTRACT(YEAR FROM data_publicacao)::int = 2024
ORDER BY conteudo_id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
