<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>beam_agregacao_catalogo_2024</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Le Parquet Silver 2024, agrega por categoria e grava Parquet. Mesmo pipeline para Beam Direct e Beam Spark.</description>
    <extended_description />
    <pipeline_version />
    <pipeline_type>Normal</pipeline_type>
    <parameters />
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 10:28:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 10:28:00.000</modified_date>
  </info>
  <notepads />
  <order>
    <hop>
      <from>Arquivo Parquet Silver 2024</from>
      <to>Somente filename</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Somente filename</from>
      <to>Ler Parquet Silver 2024</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler Parquet Silver 2024</from>
      <to>Agregacao por categoria</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregacao por categoria</from>
      <to>Gravar Parquet agregado</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Arquivo Parquet Silver 2024</name>
    <type>GetFileNames</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <GUI>
      <xloc>120</xloc>
      <yloc>160</yloc>
    </GUI>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <file>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
      <name>${PROJECT_HOME}/dados/silver/parquet/catalogo/ano=2024/catalogo.parquet.snappy</name>
    </file>
    <filefield>N</filefield>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <rownum>N</rownum>
    <attributes />
  </transform>
  <transform>
    <name>Somente filename</name>
    <type>SelectValues</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <GUI>
      <xloc>330</xloc>
      <yloc>160</yloc>
    </GUI>
    <fields>
      <field>
        <length>-2</length>
        <name>filename</name>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes />
  </transform>
  <transform>
    <name>Ler Parquet Silver 2024</name>
    <type>ParquetFileInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <GUI>
      <xloc>540</xloc>
      <yloc>160</yloc>
    </GUI>
    <fields>
      <field>
        <source_field>categoria</source_field>
        <target_field>categoria</target_field>
        <target_type>String</target_type>
      </field>
      <field>
        <source_field>conteudo_id</source_field>
        <target_field>conteudo_id</target_field>
        <target_type>Integer</target_type>
      </field>
      <field>
        <source_field>carga_horaria_min</source_field>
        <target_field>carga_horaria_min</target_field>
        <target_type>Integer</target_type>
      </field>
    </fields>
    <filename_field>filename</filename_field>
    <attributes />
  </transform>
  <transform>
    <name>Agregacao por categoria</name>
    <type>MemoryGroupBy</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <GUI>
      <xloc>760</xloc>
      <yloc>160</yloc>
    </GUI>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>categoria</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>total_conteudos</aggregate>
        <subject>conteudo_id</subject>
        <type>COUNT_ALL</type>
        <valuefield />
      </field>
      <field>
        <aggregate>media_carga_horaria_min</aggregate>
        <subject>carga_horaria_min</subject>
        <type>AVERAGE</type>
        <valuefield />
      </field>
    </fields>
    <attributes />
  </transform>
  <transform>
    <name>Gravar Parquet agregado</name>
    <type>ParquetFileOutput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <GUI>
      <xloc>1010</xloc>
      <yloc>160</yloc>
    </GUI>
    <compression_codec>SNAPPY</compression_codec>
    <data_page_size>1048576</data_page_size>
    <dictionary_page_size>1048576</dictionary_page_size>
    <fields>
      <field>
        <source_field>categoria</source_field>
        <target_field>categoria</target_field>
      </field>
      <field>
        <source_field>total_conteudos</source_field>
        <target_field>total_conteudos</target_field>
      </field>
      <field>
        <source_field>media_carga_horaria_min</source_field>
        <target_field>media_carga_horaria_min</target_field>
      </field>
    </fields>
    <filename_base>${BEAM_OUTPUT}/catalogo_categoria</filename_base>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_ext>parquet</filename_ext>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_date>N</filename_include_date>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_include_split>N</filename_include_split>
    <filename_include_time>N</filename_include_time>
    <filename_split_size>1000000</filename_split_size>
    <row_group_size>20000</row_group_size>
    <version>1.0</version>
    <attributes />
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>